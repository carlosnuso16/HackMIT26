        // EXPRESS INTEREST MODAL
        let activeInterestTrialId = null;

        function openExpressInterestModal(nctId) {
            activeInterestTrialId = nctId;
            const trial = cachedTrialResults.find(t => t.id === nctId) || { nctId: nctId, title: 'Clinical Trial Study' };
            const pUser = appState.users.patient;

            document.getElementById('expressInterestNct').textContent = trial.nctId;
            document.getElementById('expressInterestTitle').textContent = trial.title;
            document.getElementById('consentDiagnosisVal').textContent = pUser.diagnoses.map(d => d.name).join(', ');
            document.getElementById('consentAgeLocVal').textContent = `${pUser.age} yrs, ${pUser.location}`;

            document.getElementById('expressInterestModal').classList.remove('hidden');
        }

        function closeExpressInterestModal() {
            document.getElementById('expressInterestModal').classList.add('hidden');
        }

        function submitExpressInterest() {
            if (!activeInterestTrialId) return;

            const shared = [];
            if (document.getElementById('consentDiagnosis').checked) shared.push('Diagnoses');
            if (document.getElementById('consentAgeLocation').checked) shared.push('Age & Location');
            if (document.getElementById('consentEmail').checked) shared.push('Direct Email');

            const pUser = appState.users.patient;
            const trial = cachedTrialResults.find(t => t.id === activeInterestTrialId) || { nctId: activeInterestTrialId, title: 'Clinical Trial Study' };

            const newSubmission = {
                id: `sub_${Date.now()}`,
                userId: pUser.id,
                userName: pUser.name,
                nctId: trial.nctId,
                trialTitle: trial.title,
                timestamp: 'Just Now',
                sharedFields: shared,
                status: 'Awaiting Study Team Review'
            };

            appState.interestSubmissions.unshift(newSubmission);
            saveState();

            closeExpressInterestModal();
            showToast('Express interest application submitted successfully!', 'success');
        }

