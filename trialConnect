        // SOCIAL POST INTERACTIONS
        function handleCreatePost() {
            const content = document.getElementById('newPostContent').value.trim();
            const comm = document.getElementById('newPostCommunitySelect').value;
            if (!content) return;

            const currentUser = appState.users[appState.activeRole] || appState.users.patient;

            const newPost = {
                id: `post_${Date.now()}`,
                authorName: currentUser.name,
                authorAvatar: currentUser.avatar,
                community: comm,
                timestamp: 'Just now',
                type: 'standard',
                content: content,
                upvotes: 0,
                userUpvoted: false,
                comments: [],
                saved: false
            };

            appState.posts.unshift(newPost);
            document.getElementById('newPostContent').value = '';
            saveState();
            showToast('Post published to community feed!', 'success');
        }

        function togglePostUpvote(postId) {
            const post = appState.posts.find(p => p.id === postId);
            if (!post) return;

            if (post.userUpvoted) {
                post.upvotes--;
                post.userUpvoted = false;
            } else {
                post.upvotes++;
                post.userUpvoted = true;
            }
            saveState();
        }

        function togglePostSave(postId) {
            const post = appState.posts.find(p => p.id === postId);
            if (!post) return;
            post.saved = !post.saved;
            saveState();
        }

        function addPostComment(postId) {
            const input = document.getElementById(`commentInput_${postId}`);
            if (!input || !input.value.trim()) return;

            const post = appState.posts.find(p => p.id === postId);
            if (!post) return;

            const currentUser = appState.users[appState.activeRole] || appState.users.patient;

            post.comments.push({
                id: `c_${Date.now()}`,
                author: currentUser.name,
                text: input.value.trim(),
                timestamp: 'Just now'
            });

            input.value = '';
            saveState();
        }

        function toggleCommunityJoin(commId) {
            const comm = appState.communities.find(c => c.id === commId);
            if (!comm) return;

            comm.joined = !comm.joined;
            if (comm.joined) comm.members++;
            else comm.members--;

            saveState();
            showToast(`${comm.joined ? 'Joined' : 'Left'} community: ${comm.name}`, 'info');
        }

