<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrialConnect - Health Social & Clinical Recruitment Ecosystem</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        clinical: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#16a34a',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .tab-active { border-bottom: 2px solid #0284c7; color: #0284c7; font-weight: 600; }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-marker { animation: pulse-ring 2s infinite ease-in-out; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

    <header class="sticky top-0 z-40 bg-white/95 dark:bg-slate-800/95 backdrop-blur border-b border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center gap-2 sm:gap-4">
                <!-- Logo -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="navigateTo('home')">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-teal-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                        <i class="fa-solid font-bold text-xl fa-dna"></i>
                    </div>
                    <div>
                        <span class="text-xl font-black tracking-tight text-slate-900 dark:text-white">Trial<span class="text-brand-600">Connect</span></span>
                        <span class="hidden sm:inline-block text-[10px] font-semibold tracking-wider text-slate-400 uppercase ml-1.5 px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700 rounded">v2.5 Live Data</span>
                    </div>
                </div>

                <!-- Global Search Input -->
                <div class="hidden md:flex flex-1 max-w-md mx-4 relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="globalSearchInput" onkeydown="handleGlobalSearch(event)" placeholder="Search clinical trials, conditions, communities..." class="w-full pl-10 pr-4 py-2 bg-slate-100 dark:bg-slate-700/60 border border-transparent focus:border-brand-500 focus:bg-white dark:focus:bg-slate-800 text-sm rounded-full transition-all outline-none">
                </div>

                <!-- Active User & Desktop Nav Links -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- User Account Switcher -->
                    <div class="relative group">
                        <button id="userSwitchBtn" onclick="toggleUserDropdown()" class="flex items-center space-x-2 p-1.5 sm:px-3 sm:py-1.5 rounded-full border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                            <img id="headerUserAvatar" src="" class="w-7 h-7 rounded-full object-cover border border-brand-500">
                            <div class="hidden lg:block text-left text-xs">
                                <p id="headerUserName" class="font-semibold text-slate-800 dark:text-slate-100 line-clamp-1"></p>
                                <p id="headerUserRole" class="text-[10px] text-slate-500 dark:text-slate-400 uppercase font-bold tracking-wider"></p>
                            </div>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                        </button>
                        <div id="userDropdownMenu" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 py-2 z-50">
                            <div class="px-4 py-2 border-b border-slate-100 dark:border-slate-700">
                                <p class="text-xs font-semibold text-slate-400 uppercase">Switch Persona Demo</p>
                            </div>
                            <button onclick="switchUserRole('patient')" class="w-full text-left px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center space-x-3 text-xs">
                                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150" class="w-8 h-8 rounded-full">
                                <div>
                                    <div class="font-medium text-slate-800 dark:text-slate-200">Alex Morgan</div>
                                    <div class="text-[10px] text-brand-600 font-semibold">Patient (T1D & Crohn's)</div>
                                </div>
                            </button>
                            <button onclick="switchUserRole('researcher')" class="w-full text-left px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center space-x-3 text-xs">
                                <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&q=80&w=150" class="w-8 h-8 rounded-full">
                                <div>
                                    <div class="font-medium text-slate-800 dark:text-slate-200">Dr. Sarah Chen</div>
                                    <div class="text-[10px] text-emerald-600 font-semibold">Principal Investigator</div>
                                </div>
                            </button>
                            <button onclick="switchUserRole('organization')" class="w-full text-left px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-slate-700/50 flex items-center space-x-3 text-xs">
                                <img src="https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&q=80&w=150" class="w-8 h-8 rounded-full">
                                <div>
                                    <div class="font-medium text-slate-800 dark:text-slate-200">Dana-Farber Institute</div>
                                    <div class="text-[10px] text-purple-600 font-semibold">Verified Clinical Site</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Action Badges -->
                    <button onclick="navigateTo('my-interests')" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 relative" title="My Submitted Interests & Saved">
                        <i class="fa-solid fa-bookmark text-base"></i>
                        <span id="savedCountBadge" class="hidden absolute top-1 right-1 w-4 h-4 bg-brand-600 text-white rounded-full text-[10px] font-bold flex items-center justify-center">0</span>
                    </button>
                    
                    <button onclick="navigateTo('notifications')" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 relative" title="Notifications">
                        <i class="fa-solid fa-bell text-base"></i>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-rose-500 rounded-full"></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Primary Navigation Bar -->
        <nav class="bg-slate-100/80 dark:bg-slate-800/80 border-t border-slate-200 dark:border-slate-700 overflow-x-auto custom-scrollbar">
            <div class="max-w-7xl mx-auto px-4 flex space-x-1 sm:space-x-6 text-xs sm:text-sm font-medium whitespace-nowrap">
                <button onclick="navigateTo('home')" id="nav-home" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-house"></i> <span>Community Feed</span>
                </button>
                <button onclick="navigateTo('trials')" id="nav-trials" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-vial"></i> <span>Clinical Trials Discovery</span>
                    <span class="px-1.5 py-0.5 text-[10px] bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 rounded-full font-bold">LIVE API</span>
                </button>
                <button onclick="navigateTo('communities')" id="nav-communities" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-people-group"></i> <span>Condition Communities</span>
                </button>
                <button onclick="navigateTo('analytics')" id="nav-analytics" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-chart-line"></i> <span>Research Demand Gaps</span>
                </button>
                <button onclick="navigateTo('researcher')" id="nav-researcher" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-microscope"></i> <span>Researcher Portal</span>
                </button>
                <button onclick="navigateTo('profile')" id="nav-profile" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-user"></i> <span>My Patient Profile</span>
                </button>
                <button onclick="navigateTo('settings')" id="nav-settings" class="nav-tab py-3 px-2 border-b-2 border-transparent hover:text-brand-600 flex items-center space-x-2">
                    <i class="fa-solid fa-gear"></i> <span>Settings</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

        <!-- ================= PAGE 1: HOME FEED ================= -->
        <section id="page-home" class="page-view space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Left Sidebar: Patient Summary -->
                <div class="lg:col-span-1 space-y-4">
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm text-center">
                        <img id="sidebarUserAvatar" src="" class="w-20 h-20 rounded-full mx-auto object-cover border-2 border-brand-500 shadow-md">
                        <h3 id="sidebarUserName" class="mt-3 font-bold text-slate-800 dark:text-white text-base"></h3>
                        <p id="sidebarUserLocation" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"><i class="fa-solid fa-location-dot mr-1"></i><span></span></p>
                        
                        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700/60 text-left">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">My Diagnoses</span>
                                <button onclick="openEditProfileModal()" class="text-[11px] text-brand-600 hover:underline">Edit</button>
                            </div>
                            <div id="sidebarDiagnosesList" class="flex flex-wrap gap-1.5">
                                <!-- Diagnoses rendered dynamically -->
                            </div>
                        </div>

                        <button onclick="triggerMatchMyProfile()" class="w-full mt-5 py-2.5 px-4 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-xl shadow-md transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span>Match Trials to Profile</span>
                        </button>
                    </div>

                    <!-- Quick Stats Card -->
                    <div class="bg-gradient-to-br from-brand-900 to-slate-900 text-white rounded-2xl p-5 shadow-sm space-y-3">
                        <div class="flex justify-between items-center text-xs text-brand-200">
                            <span>Clinical Registries Status</span>
                            <span class="flex items-center"><span class="w-2 h-2 bg-emerald-400 rounded-full mr-1.5 animate-pulse"></span> Live API</span>
                        </div>
                        <div class="text-xl font-bold">ClinicalTrials.gov</div>
                        <p class="text-xs text-slate-300 leading-relaxed">Direct REST v2 endpoints active for 450,000+ real-world clinical studies.</p>
                        <button onclick="navigateTo('trials')" class="inline-flex items-center text-xs font-semibold text-brand-300 hover:text-white pt-1">Explore Studies <i class="fa-solid fa-arrow-right ml-1.5"></i></button>
                    </div>
                </div>

                <!-- Main Social Feed -->
                <div class="lg:col-span-2 space-y-4">
                    <!-- Create Post Widget -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200 dark:border-slate-700 shadow-sm">
                        <div class="flex items-start space-x-3">
                            <img id="createPostAvatar" src="" class="w-10 h-10 rounded-full object-cover">
                            <div class="flex-1">
                                <textarea id="newPostContent" rows="2" placeholder="Share a symptom, treatment query, or clinical trial update..." class="w-full p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-200 dark:border-slate-600 text-xs sm:text-sm focus:bg-white focus:border-brand-500 outline-none resize-none"></textarea>
                                <div class="mt-2 flex items-center justify-between">
                                    <div class="flex items-center space-x-2 text-xs text-slate-500">
                                        <select id="newPostCommunitySelect" class="bg-slate-100 dark:bg-slate-700 rounded-lg px-2.5 py-1 text-xs border border-slate-200 dark:border-slate-600">
                                            <option value="General Health">General Discussion</option>
                                            <option value="Crohn's & IBD Network">Crohn's & IBD Network</option>
                                            <option value="Type 1 Diabetes Research">Type 1 Diabetes Research</option>
                                            <option value="Rare Disease Advocates">Rare Disease Advocates</option>
                                        </select>
                                    </div>
                                    <button onclick="handleCreatePost()" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs rounded-lg shadow-sm transition">
                                        Post <i class="fa-solid fa-paper-plane ml-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Feed Filter Tabs -->
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-2">
                        <div class="flex space-x-4 text-xs font-semibold text-slate-500">
                            <button onclick="filterFeed('all')" id="feed-filter-all" class="text-brand-600 border-b-2 border-brand-600 pb-2">All Posts</button>
                            <button onclick="filterFeed('questions')" id="feed-filter-questions" class="hover:text-slate-800 pb-2">Patient Questions</button>
                            <button onclick="filterFeed('opportunities')" id="feed-filter-opportunities" class="hover:text-slate-800 pb-2">Research Studies</button>
                        </div>
                        <span class="text-xs text-slate-400" id="feedCountText">Showing active community activity</span>
                    </div>

                    <!-- Post Feed Container -->
                    <div id="postsFeedContainer" class="space-y-4">
                        <!-- Posts rendered dynamically -->
                    </div>
                </div>

                <!-- Right Sidebar: Trending & Featured Live Trials -->
                <div class="lg:col-span-1 space-y-4">
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm">
                        <h4 class="font-bold text-slate-800 dark:text-white text-sm flex items-center justify-between">
                            <span>Featured Live Trials</span>
                            <span class="text-[10px] text-emerald-600 font-semibold bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded">Verified</span>
                        </h4>
                        <div id="featuredLiveTrialsContainer" class="mt-4 space-y-3">
                            <div class="animate-pulse space-y-2">
                                <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-3/4"></div>
                                <div class="h-3 bg-slate-200 dark:bg-slate-700 rounded w-1/2"></div>
                            </div>
                        </div>
                        <button onclick="navigateTo('trials')" class="w-full mt-4 py-2 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-semibold transition">Search All Clinical Trials</button>
                    </div>

                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm">
                        <h4 class="font-bold text-slate-800 dark:text-white text-sm mb-3">Popular Communities</h4>
                        <div id="popularCommunitiesSidebar" class="space-y-2 text-xs">
                            <!-- Rendered dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PAGE 2: CLINICAL TRIALS DISCOVERY (LIVE API) ================= -->
        <section id="page-trials" class="page-view hidden space-y-6">
            <!-- Header Banner -->
            <div class="bg-gradient-to-r from-slate-900 via-brand-900 to-slate-900 rounded-2xl p-6 text-white shadow-md relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <div class="inline-flex items-center space-x-2 bg-brand-500/30 backdrop-blur border border-brand-400/30 px-3 py-1 rounded-full text-xs font-semibold text-brand-200 mb-3">
                        <i class="fa-solid fa-database"></i> <span>Direct Integration with ClinicalTrials.gov REST API v2</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Real-World Clinical Trial Discovery Engine</h1>
                    <p class="text-slate-300 text-xs sm:text-sm mt-2 leading-relaxed">Search over 450,000+ registered global clinical studies dynamically. Filter by condition, location radius, phase, age, and recruitment status with zero synthetic data.</p>
                </div>
                <i class="fa-solid fa-microscope absolute -right-6 -bottom-6 text-9xl text-white/5 pointer-events-none"></i>
            </div>

            <!-- Search & Filter Controls Bar -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 sm:p-5 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                    <div class="md:col-span-5 relative">
                        <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Condition or Keyword</label>
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            <input type="text" id="trialSearchCondition" placeholder="e.g. Crohn's Disease, Type 1 Diabetes, Melanoma" class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-700/60 border border-slate-200 dark:border-slate-600 rounded-xl text-xs sm:text-sm focus:border-brand-500 outline-none">
                        </div>
                    </div>
                    <div class="md:col-span-4 relative">
                        <label class="block text-[11px] font-bold text-slate-400 uppercase mb-1">Location / City / ZIP</label>
                        <div class="relative">
                            <i class="fa-solid fa-location-dot absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            <input type="text" id="trialSearchLocation" placeholder="e.g. Boston, MA or 02114" class="w-full pl-9 pr-3 py-2 bg-slate-50 dark:bg-slate-700/60 border border-slate-200 dark:border-slate-600 rounded-xl text-xs sm:text-sm focus:border-brand-500 outline-none">
                        </div>
                    </div>
                    <div class="md:col-span-3 flex items-end space-x-2">
                        <button onclick="executeTrialSearch()" class="flex-1 py-2 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-search"></i> <span>Search API</span>
                        </button>
                        <button onclick="triggerMatchMyProfile()" class="py-2 px-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center space-x-1" title="Match against my active profile">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                            <span class="hidden sm:inline">Match Profile</span>
                        </button>
                    </div>
                </div>

                <!-- Expanded Filters Row -->
                <div class="pt-3 border-t border-slate-100 dark:border-slate-700/60 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-500 mb-1">Recruitment Status</label>
                        <select id="filterStatus" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 outline-none">
                            <option value="RECRUITING">Recruiting Only</option>
                            <option value="ALL">All Statuses</option>
                            <option value="NOT_YET_RECRUITING">Not Yet Recruiting</option>
                            <option value="ACTIVE_NOT_RECRUITING">Active, Not Recruiting</option>
                            <option value="COMPLETED">Completed</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 mb-1">Study Phase</label>
                        <select id="filterPhase" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 outline-none">
                            <option value="ALL">All Phases</option>
                            <option value="PHASE1">Phase 1</option>
                            <option value="PHASE2">Phase 2</option>
                            <option value="PHASE3">Phase 3</option>
                            <option value="PHASE4">Phase 4</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 mb-1">Study Type</label>
                        <select id="filterStudyType" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 outline-none">
                            <option value="ALL">All Types</option>
                            <option value="INTERVENTIONAL">Interventional</option>
                            <option value="OBSERVATIONAL">Observational</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 mb-1">Distance / Radius</label>
                        <select id="filterRadius" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 outline-none">
                            <option value="50">Within 50 miles</option>
                            <option value="25">Within 25 miles</option>
                            <option value="100">Within 100 miles</option>
                            <option value="ANY">Any Distance</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 mb-1">Target Age</label>
                        <input type="number" id="filterAge" placeholder="e.g. 27" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 outline-none">
                    </div>

                    <div class="flex items-end">
                        <button onclick="resetTrialFilters()" class="w-full py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-lg font-semibold transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Reset Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Profile Match Alert Box (Shows if Profile Match active) -->
