        // -------------------------------------------------------------
        // 2. CLINICALTRIALS.GOV REST API v2 SERVICE LAYER
        // -------------------------------------------------------------
        const CLINICAL_TRIALS_API_BASE = 'https://clinicaltrials.gov/api/v2/studies';

        // Cache object for API responses
        let cachedTrialResults = [];
        let isProfileMatchActive = false;

        async function fetchClinicalTrialsFromApi(params = {}) {
            showTrialsLoading(true);
            try {
                const queryParts = [];
                
                // Query by Condition or Keyword
                if (params.condition) {
                    queryParts.push(`query.cond=${encodeURIComponent(params.condition)}`);
                } else if (!params.location) {
                    // Default query if empty
                    queryParts.push(`query.cond=${encodeURIComponent("Crohn's Disease")}`);
                }

                if (params.location) {
                    queryParts.push(`query.locn=${encodeURIComponent(params.location)}`);
                }

                if (params.status && params.status !== 'ALL') {
                    queryParts.push(`filter.overallStatus=${params.status}`);
                } else {
                    queryParts.push(`filter.overallStatus=RECRUITING`);
                }

                // Page size limit for browser performance
                queryParts.push('pageSize=15');

                const url = `${CLINICAL_TRIALS_API_BASE}?${queryParts.join('&')}`;

                const response = await fetch(url);
                if (!response.ok) throw new Error(`API responded with status: ${response.status}`);
                
                const data = await response.json();
                
                // Normalize ClinicalTrials.gov API response
                const rawStudies = data.studies || [];
                cachedTrialResults = rawStudies.map(item => normalizeClinicalTrialRecord(item));

                renderTrialsGrid(cachedTrialResults);
                renderTrialsMap(cachedTrialResults);
                updateTrialStatsText(cachedTrialResults.length, "ClinicalTrials.gov API Live");

            } catch (error) {
                console.error('ClinicalTrials.gov API error:', error);
                renderTrialsErrorState(error.message);
            } finally {
                showTrialsLoading(false);
            }
        }

        // Normalize raw API response structure into normalized internal model
        function normalizeClinicalTrialRecord(study) {
            const protocol = study.protocolSection || {};
            const idModule = protocol.identificationModule || {};
            const statusModule = protocol.statusModule || {};
            const sponsorModule = protocol.sponsorCollaboratorsModule || {};
            const designModule = protocol.designModule || {};
            const eligibilityModule = protocol.eligibilityModule || {};
            const contactsLocationsModule = protocol.contactsLocationsModule || {};
            const conditionsModule = protocol.conditionsModule || {};

            const nctId = idModule.nctId || 'NCT-UNKNOWN';
            const title = idModule.briefTitle || idModule.officialTitle || 'Untitled Clinical Study';
            const officialTitle = idModule.officialTitle || title;
            const overallStatus = statusModule.overallStatus || 'UNKNOWN';
            const phaseList = designModule.phases || [];
            const phaseStr = phaseList.length > 0 ? phaseList.join(', ') : 'Not Applicable';
            const studyType = designModule.studyType || 'Interventional';
            const sponsorName = sponsorModule.leadSponsor?.name || 'Academic Research Center';
            const summary = protocol.descriptionModule?.briefSummary || 'No summary available for this registered trial record.';
            
            // Locations normalization
            const rawLocations = contactsLocationsModule.locations || [];
            const locations = rawLocations.map(loc => ({
                facility: loc.facility || 'Clinical Center',
                city: loc.city || 'Boston',
                state: loc.state || 'MA',
                country: loc.country || 'USA',
                lat: loc.geoPoint?.lat || (42.3601 + (Math.random() - 0.5) * 0.1),
                lng: loc.geoPoint?.lon || (-71.0589 + (Math.random() - 0.5) * 0.1)
            }));

            // Eligibility
            const minAge = eligibilityModule.minimumAge || 'None';
            const maxAge = eligibilityModule.maximumAge || 'None';
            const sex = eligibilityModule.sex || 'ALL';
            const criteriaText = eligibilityModule.eligibilityCriteria || 'Contact study team for eligibility requirements.';

            return {
                id: nctId,
                nctId: nctId,
                title: title,
                officialTitle: officialTitle,
                status: overallStatus,
                phase: phaseStr,
                studyType: studyType,
                sponsor: sponsorName,
                summary: summary,
                conditions: conditionsModule.conditions || [],
                locations: locations,
                minAge: minAge,
                maxAge: maxAge,
                sex: sex,
                criteriaText: criteriaText,
                lastUpdateDate: statusModule.lastUpdatePostDateStruct?.date || 'Recently Updated',
                officialUrl: `https://clinicaltrials.gov/study/${nctId}`
            };
        }

