                    <div class="pt-3 border-t border-slate-100 dark:border-slate-700 flex justify-between items-center text-xs text-slate-400">
                        <span><i class="fa-solid fa-users mr-1"></i>${c.members.toLocaleString()} Members</span>
                        <span class="text-brand-600 font-semibold cursor-pointer" onclick="navigateTo('home')">View Discussions <i class="fa-solid fa-arrow-right ml-1"></i></span>
                    </div>
                </div>
            `).join('');
        }

        function renderGapAnalytics() {
            const topics = [
                { id: 'gap_1', title: 'Non-Invasive Biologics for Pediatric IBD', desc: 'Oral or transdermal delivery options vs weekly injections.', votes: appState.gapVotes['gap_1'] },
                { id: 'gap_2', title: 'Continuous Glucose Monitor Integrations in Steroid Treatments', desc: 'Real-time glycemic variance tracking during autoimmune flares.', votes: appState.gapVotes['gap_2'] },
                { id: 'gap_3', title: 'Dietary Microbiome Therapies for Remission Maintenance', desc: 'Clinical evaluation of specialized enteral nutrition protocols.', votes: appState.gapVotes['gap_3'] }
            ];

            const container = document.getElementById('researchGapTopicsContainer');
            if (!container) return;

            container.innerHTML = topics.map(t => `
                <div class="p-3.5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div>
                        <h4 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100">${t.title}</h4>
                        <p class="text-[11px] text-slate-500 mt-0.5">${t.desc}</p>
                    </div>
                    <button onclick="voteGapTopic('${t.id}')" class="px-3 py-1.5 bg-purple-50 text-purple-700 border border-purple-200 hover:bg-purple-100 font-bold text-xs rounded-xl flex items-center space-x-1.5 transition whitespace-nowrap">
                        <i class="fa-solid fa-up-long"></i> <span>Vote Priority (${t.votes})</span>
                    </button>
                </div>
            `).join('');
        }

        function voteGapTopic(topicId) {
            appState.gapVotes[topicId] = (appState.gapVotes[topicId] || 0) + 1;
            saveState();
            renderGapAnalytics();
            showToast('Vote recorded for patient research priority!', 'success');
        }

        function renderResearcherPortal() {
            const rUser = appState.users.researcher;
            document.getElementById('researcherDashboardTitle').textContent = `PI Dashboard: ${rUser.name}`;

            // Render Opportunities
            const oppContainer = document.getElementById('researcherOpportunitiesContainer');
            oppContainer.innerHTML = appState.researcherOpportunities.map(opp => `
                <div class="p-4 bg-slate-50 dark:bg-slate-700/30 rounded-xl border border-slate-200 dark:border-slate-600 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="px-2 py-0.5 bg-purple-100 text-purple-700 text-[10px] font-bold rounded uppercase">Platform Opportunity</span>
                            <span class="text-xs text-emerald-600 font-bold">${opp.status}</span>
                        </div>
                        <h4 class="font-bold text-sm text-slate-800 dark:text-white mt-1">${opp.title}</h4>
                        <p class="text-xs text-slate-500 mt-0.5 line-clamp-1">${opp.desc}</p>
                    </div>
                    <span class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-xs font-bold text-slate-700 rounded-lg">
                        ${opp.interestedCount} Interested Patients
                    </span>
                </div>
            `).join('');

            // Render Submissions Table
            const tbody = document.getElementById('researcherSubmissionsTableBody');
            tbody.innerHTML = appState.interestSubmissions.map(s => `
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                    <td class="p-3 font-semibold text-slate-800 dark:text-slate-200">${s.userName}</td>
                    <td class="p-3 text-brand-600 font-bold">${s.nctId}</td>
                    <td class="p-3">${s.sharedFields.join(', ')}</td>
                    <td class="p-3 text-slate-500">${s.timestamp}</td>
                    <td class="p-3"><span class="px-2 py-0.5 bg-amber-100 text-amber-800 font-bold text-[10px] rounded">${s.status}</span></td>
                    <td class="p-3">
                        <button onclick="showToast('Contact request initiated with ${s.userName}', 'info')" class="px-2.5 py-1 bg-brand-600 text-white font-bold text-[10px] rounded hover:bg-brand-700">Contact Patient</button>
                    </td>
                </tr>
            `).join('');
        }

        function renderSavedAndSubmittedInterests() {
            // Saved Trials
            const savedContainer = document.getElementById('savedTrialsListContainer');
            if (appState.savedTrialIds.length === 0) {
                savedContainer.innerHTML = `<p class="text-xs text-slate-400 italic">No saved clinical trials yet.</p>`;
            } else {
                savedContainer.innerHTML = appState.savedTrialIds.map(nctId => `
                    <div class="p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-slate-200 dark:border-slate-600 flex justify-between items-center">
                        <div>
                            <span class="text-xs font-bold text-brand-600">${nctId}</span>
                            <h4 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100 mt-0.5">Saved Clinical Study Protocol</h4>
                        </div>
                        <div class="flex space-x-2">
                            <button onclick="openTrialDetailModal('${nctId}')" class="px-3 py-1 bg-white dark:bg-slate-800 border border-slate-200 text-xs font-semibold rounded-lg">View</button>
                            <button onclick="toggleSaveTrial('${nctId}')" class="px-3 py-1 bg-rose-50 text-rose-600 text-xs font-semibold rounded-lg">Remove</button>
                        </div>
                    </div>
                `).join('');
            }

            // Submitted Interests
            const subContainer = document.getElementById('submittedInterestsListContainer');
            if (appState.interestSubmissions.length === 0) {
                subContainer.innerHTML = `<p class="text-xs text-slate-400 italic">No expressed interest applications submitted yet.</p>`;
            } else {
                subContainer.innerHTML = appState.interestSubmissions.map(s => `
                    <div class="p-4 bg-slate-50 dark:bg-slate-700/40 rounded-xl border border-slate-200 dark:border-slate-600 space-y-2">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs font-bold text-brand-600">${s.nctId}</span>
                                <h4 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100 line-clamp-1 mt-0.5">${s.trialTitle}</h4>
                            </div>
                            <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 text-[10px] font-bold rounded">${s.status}</span>
                        </div>
                        <p class="text-[11px] text-slate-500">Shared Parameters: ${s.sharedFields.join(', ')} • Submitted: ${s.timestamp}</p>
                    </div>
                `).join('');
            }
        }

        // UTILITY FUNCTIONS
        function showTrialsLoading(isLoading) {
            const countEl = document.getElementById('trialsResultCount');
            if (isLoading && countEl) {
                countEl.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-brand-600 mr-2"></i> Fetching live records from ClinicalTrials.gov REST API...`;
            }
        }

        function updateTrialStatsText(count, source) {
            const countEl = document.getElementById('trialsResultCount');
            const timeEl = document.getElementById('lastUpdatedTimestamp');
            if (countEl) countEl.textContent = `Displaying ${count} Live Clinical Studies`;
            if (timeEl) timeEl.textContent = `• Source: ${source} (${new Date().toLocaleTimeString()})`;
        }

        function renderTrialsErrorState(msg) {
            const container = document.getElementById('trialsContainer');
            if (!container) return;
            container.innerHTML = `
                <div class="col-span-full text-center py-12 bg-rose-50 dark:bg-rose-950/30 rounded-2xl border border-rose-200 dark:border-rose-800 p-6">
                    <i class="fa-solid fa-circle-exclamation text-3xl text-rose-500 mb-2"></i>
                    <h4 class="font-bold text-rose-900 dark:text-rose-200 text-sm">We couldn't retrieve current clinical-trial information right now.</h4>
                    <p class="text-xs text-rose-700 dark:text-rose-300 mt-1">Please try again. (${msg})</p>
                    <button onclick="executeTrialSearch()" class="mt-4 px-4 py-2 bg-rose-600 text-white font-bold text-xs rounded-xl shadow">Retry API Request</button>
                </div>
            `;
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `p-3 rounded-xl shadow-lg border text-xs font-semibold text-white transition-all transform translate-y-2 pointer-events-auto flex items-center justify-between space-x-3 ${type === 'success' ? 'bg-emerald-600 border-emerald-500' : 'bg-slate-800 border-slate-700'}`;
            toast.innerHTML = `<span>${message}</span> <i class="fa-solid fa-xmark cursor-pointer" onclick="this.parentElement.remove()"></i>`;

            container.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3500);
        }

        function exportUserDataJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `trialconnect_export_${Date.now()}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function resetAppStateToDefault() {
            localStorage.removeItem(STORAGE_KEY);
            appState = defaultAppState;
            saveState();
            location.reload();
        }

        // -------------------------------------------------------------
        // 7. INITIALIZATION ON WINDOW LOAD
        // -------------------------------------------------------------
        window.onload = function() {
            updateAllUIElements();
            navigateTo('home');
            
            // Execute default ClinicalTrials.gov API fetch
            executeTrialSearch();
        };
    </script>
</body>
</html>
